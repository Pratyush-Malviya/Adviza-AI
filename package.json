{
  "name": "adviza-ai-monorepo",
  "version": "3.5.0",
  "private": true,
  "scripts": {
    "dev:website": "npm --prefix adviza-website run dev",
    "dev:frontend": "npm --prefix adviza-frontend run dev",
    "dev:backend": "npm --prefix adviza-backend run dev",
    "build:website": "npm --prefix adviza-website run build",
    "build:frontend": "npm --prefix adviza-frontend run build",
    "build:backend": "npm --prefix adviza-backend run build",
    "build:all": "npm run build:backend && npm run build:frontend && npm run build:website"
  }
}
